# Edge AI settings. Loaded by src/config.py (every key is validated at startup).

API_BASE_URL=http://127.0.0.1:3000
# Same value as EDGE_API_TOKEN in apps/backend/.env (generated by scripts/init-env.mjs)
EDGE_API_TOKEN=__EDGE_TOKEN__
ZONE_ID=1

CAMERA_INDEX=0
MODEL_PATH=models/yolo11n.pt
# Starting values to be re-measured, not validated results
DETECT_CONFIDENCE=0.35
IMAGE_SIZE=640
CONFIRM_FRAMES=3
COOLDOWN_SECONDS=10
SEND_EVIDENCE=false
LOG_LEVEL=INFO
