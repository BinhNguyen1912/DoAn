# Backend settings. Copy to .env (or run `node scripts/init-env.mjs`).
# Every key is validated at startup by src/config/env.schema.ts.

NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed by CORS. Leave empty when the web app uses the /api proxy.
CORS_ORIGINS=

# Database (matches the compose.yaml service published on 127.0.0.1 in development)
DATABASE_URL=postgresql://safezone:__DB_PASSWORD__@127.0.0.1:55432/safe_zone_monitor

# Shared secrets (min 16 chars). Generated by scripts/init-env.mjs; never commit real values.
EDGE_API_TOKEN=__GENERATE__
DEVICE_API_TOKEN=__GENERATE__

# ESP32 speaker on the LAN
ESP32_BASE_URL=http://192.168.1.50
ESP32_REQUEST_TIMEOUT_MS=3000
ALERT_MAX_RETRIES=2
DEVICE_HEARTBEAT_INTERVAL_MS=10000

# Evidence images (off by default for privacy)
EVIDENCE_ENABLED=false
EVIDENCE_DIR=./data/evidence
EVIDENCE_RETENTION_DAYS=7
EVIDENCE_MAX_BYTES=2000000
