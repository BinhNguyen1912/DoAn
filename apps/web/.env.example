# Web dashboard settings (Vite exposes only VITE_* keys to the browser: never put secrets here).

# Base path the browser calls. Leave empty: the OpenAPI paths already include the /api prefix
# (e.g. /api/zones), and the Vite dev proxy forwards /api to the backend (same-origin, no CORS).
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api to
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000
# How often the dashboard polls device status (ms)
VITE_DEVICE_POLL_MS=5000
# Set to "true" to serve mock data instead of calling the backend (UI preview without DB).
VITE_USE_MOCK=true