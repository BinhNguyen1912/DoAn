# Web dashboard settings (Vite exposes only VITE_* keys to the browser: never put secrets here).

# Base path the browser calls. Same-origin /api avoids CORS (dev: Vite proxy, prod: nginx).
VITE_API_BASE_URL=/api
# Where the Vite dev server proxies /api to
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000
# How often the dashboard polls device status
VITE_DEVICE_POLL_MS=5000
