# Used by compose.yaml only. Each app has its own .env.example next to it.
# Run `node scripts/init-env.mjs` to create every .env with generated secrets.

POSTGRES_USER=safezone
POSTGRES_PASSWORD=__DB_PASSWORD__
POSTGRES_DB=safe_zone_monitor
# Host port for the dev database (bound to 127.0.0.1 only; 5432 is left free on purpose)
POSTGRES_HOST_PORT=55432
